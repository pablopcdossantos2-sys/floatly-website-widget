{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-remote-heartbeat",
  "description": "Permite al sitio web configurado enviar únicamente la señal autenticada de actividad.",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "http://*",
      "https://*"
    ]
  },
  "permissions": [
    "allow-heartbeat"
  ]
}
