{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "investing-drag",
  "description": "Permite apenas que o Investing.com solicite o início do arraste nativo do widget.",
  "windows": ["main"],
  "remote": {
    "urls": [
      "https://br.investing.com/**",
      "https://*.investing.com/**"
    ]
  },
  "permissions": [
    "core:window:allow-start-dragging"
  ]
}