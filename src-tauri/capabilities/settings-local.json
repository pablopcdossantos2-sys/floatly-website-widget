{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings-local",
  "description": "Permissões restritas à interface local de configurações.",
  "windows": [
    "settings"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-get-config",
    "allow-save-config",
    "allow-close-settings"
  ]
}
